{
  "name": "nestable-tailwind-variants",
  "version": "0.4.5",
  "description": "Tailwind CSS variant library with nestable conditions for compound styling instead of flat compoundVariants.",
  "homepage": "https://github.com/yuheiy/nestable-tailwind-variants#readme",
  "bugs": {
    "url": "https://github.com/yuheiy/nestable-tailwind-variants/issues"
  },
  "license": "MIT",
  "author": "Yuhei Yasuda <yuhei.yasuda1003@gmail.com> (https://yuheiy.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuheiy/nestable-tailwind-variants.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "git clean -fx dist/ && tsc -p tsconfig.build.json",
    "test": "vitest",
    "check": "oxfmt --check && oxlint",
    "check:fix": "oxlint --fix && oxfmt",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "knip": "knip",
    "release": "bumpp",
    "prepare": "git config --local core.hooksPath .githooks",
    "prepublishOnly": "node --run build"
  },
  "dependencies": {
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "bumpp": "^12.2.2",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.20.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.2"
}
