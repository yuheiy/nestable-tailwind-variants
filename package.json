{
  "name": "nestable-tailwind-variants",
  "version": "0.5.0",
  "description": "Define Tailwind CSS variants with nested conditions.",
  "homepage": "https://github.com/yuheiy/nestable-tailwind-variants#readme",
  "bugs": {
    "url": "https://github.com/yuheiy/nestable-tailwind-variants/issues"
  },
  "license": "MIT",
  "author": "Yuhei Yasuda <yuhei.yasuda1003@gmail.com> (https://yuheiy.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuheiy/nestable-tailwind-variants.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "git clean -fx dist/ && tsc -p tsconfig.build.json",
    "test": "node --run test:unit -- --run && node --run test:declarations",
    "test:unit": "vitest --typecheck",
    "test:declarations": "node --run build && node test/declarations/run.mjs",
    "check": "oxfmt --check && oxlint",
    "check:fix": "oxlint --fix && oxfmt",
    "fmt": "oxfmt",
    "lint": "oxlint",
    "knip": "knip",
    "release": "bumpp",
    "prepare": "git config --local core.hooksPath .githooks",
    "prepublishOnly": "node --run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "bumpp": "^12.2.2",
    "cn": "^0.2.3",
    "knip": "^6.34.0",
    "lint-staged": "^17.4.1",
    "oxfmt": "^0.66.0",
    "oxlint": "^1.81.0",
    "oxlint-tsgolint": "^7.0.2001",
    "tailwind-merge": "^3.6.0",
    "typescript": "~7.0.2",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*": "oxfmt --no-error-on-unmatched-pattern",
    "*.{js,jsx,ts,tsx,mjs,cjs}": "oxlint"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^24.20.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.2"
}
