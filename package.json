{
  "name": "nestable-tailwind-variants",
  "version": "0.5.1",
  "description": "Define Tailwind CSS variants with nested conditions.",
  "homepage": "https://github.com/yuheiy/nestable-tailwind-variants#readme",
  "bugs": {
    "url": "https://github.com/yuheiy/nestable-tailwind-variants/issues"
  },
  "license": "MIT",
  "author": "Yuhei Yasuda <yuhei.yasuda1003@gmail.com> (https://yuheiy.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yuheiy/nestable-tailwind-variants.git"
  },
  "files": [
    "dist",
    "src"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "git clean -fx dist/ && tsc -p tsconfig.build.json",
    "check": "vp check",
    "check:fix": "vp check --fix",
    "knip": "knip",
    "test": "node --run test:unit && node --run test:declarations && node --run test:completions",
    "test:unit": "vp test --typecheck --run",
    "test:declarations": "node --run build && node test/declarations/run.mjs",
    "test:completions": "node test/completions/run.mjs",
    "release": "bumpp",
    "prepare": "git config --local core.hooksPath .githooks",
    "prepublishOnly": "node --run build"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "bumpp": "^12.2.2",
    "cn": "^0.2.3",
    "knip": "^6.34.0",
    "tailwind-merge": "^3.6.0",
    "typescript": "~7.0.2",
    "vite-plus": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.22.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.3.2"
}
