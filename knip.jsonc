{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "ignoreFiles": ["test/declarations/fixtures/**"],
  // Knip reports `pnpm stage` as an unlisted binary: https://github.com/webpro-nl/knip/issues/2013
  "ignoreBinaries": ["stage"],
  "ignoreDependencies": ["@commitlint/cli", "lint-staged"],
}
